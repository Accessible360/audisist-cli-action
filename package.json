{
  "name": "audisist-cli-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action wrapper for audisist-cli accessibility scanning",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build lib/index.js -o dist --source-map --license licenses.txt",
    "prepare": "npm run build && husky",
    "test": "node --test lib/*.test.js",
    "test:watch": "node --test --watch lib/*.test.js"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.4"
  },
  "lint-staged": {
    "lib/**/*.{js,json,yml,yaml}": "prettier --write"
  },
  "packageManager": "yarn@3.4.1+sha512.a333bf9c2557d71f5ba87dd1446cde24bb9c35301ec29dd2baba577b3f9d1ab61348b66a1324de9088c40a996c5b9203794da8bf14cab9fae6a6eccc00cb8078"
}
